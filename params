
from enum import Enum
import numpy as np
import threading

# BehaviorState 열거형
class BehaviorState(Enum):
    START = 0
    TROT = 1
    REST = 2

# 싱글톤 기초 클래스
class Singleton:
    _instances = {}
    _lock = threading.Lock()

    def __new__(cls, *args, **kwargs):
        with cls._lock:
            if cls not in cls._instances:
                cls._instances[cls] = super(Singleton, cls).__new__(cls, *args, **kwargs)
        return cls._instances[cls]

# RobotState 클래스 (싱글톤으로 동작)
class RobotState(Singleton):
    def __init__(self, default_height=0.5): 
        if not hasattr(self, "initialized"):  # 중복 초기화 방지
            self.velocity = [0.0, 0.0]  # 속도 (x, y)
            self.yaw_rate = 0.0  # Yaw 회전 속도
            self.robot_height = -default_height  # 로봇 기본 높이
            self.imu_roll = 0.0  # IMU Roll
            self.imu_pitch = 0.0  # IMU Pitch
            self.foot_location = np.zeros((3, 4))
            self.body_local_position = np.array([0.0, 0.0, 0.0])
            self.body_local_orientation = np.array([0.0, 0.0, 0.0])
            self.ticks = 0
            self.behavior_state = BehaviorState.REST  # 기본 상태
            
            self.initialized = True  # 초기화 완료 플래그
            self.update_called = False

    def update(self, **kwargs):
        with self._lock:
            for key, value in kwargs.items():
                if hasattr(self, key):
                    setattr(self, key, value)
                    self.update_called = True

# RobotCommand 클래스 (싱글톤으로 동작)
class RobotCommand(Singleton):
    def __init__(self, default_height=0.5):
        if not hasattr(self, "initialized"):  # 중복 초기화 방지
            self.trot_event = False
            self.rest_event = False
            self.start_event = False
            self.velocity = [0.0, 0.0]  # 속도 (x, y)
            self.yaw_rate = 0.0  # Yaw 회전 속도
            self.robot_height = -default_height  # 로봇 기본 높이
            self.initialized = True  # 초기화 완료 플래그

    def update(self, **kwargs):
        for key, value in kwargs.items():
            if hasattr(self, key):
                setattr(self, key, value)

# LegParameters 클래스 (싱글톤으로 동작)
class LegParameters(Singleton):
    def __init__(self):
        if not hasattr(self, "initialized"):  # 중복 초기화 방지
            self.pose = self.Leg_Pose()
            self.gait = self.Trot_Gait_Param()
            self.physical = self.Physical_Params()
            self.initialized = True  # 초기화 완료 플래그

    def update(self, **kwargs):
        for key, value in kwargs.items():
            if hasattr(self, key):
                setattr(self, key, value)

    class Leg_Pose:
        def __init__(self):
            self.def_stance = np.zeros((3, 4))
            self.initial_pose = np.zeros((3, 4))

    class Trot_Gait_Param:
        def __init__(self):
            self.cycle_time = None
            self.stance_time = 0.18
            self.swing_time = 0.24
            self.time_step = 0.02
            self.max_x_vel = 100
            self.max_y_vel = 100
            self.max_yaw_rate = 1.2
            self.z_leg_lift = 0.7

    class Physical_Params:
        l1 = 100
        l2 = 100
        l3 = 100
        l4 = 100
